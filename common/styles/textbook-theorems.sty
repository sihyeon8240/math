\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{textbook-theorems}[2026/09/02 Theorem environments and reference names]

% Direct dependencies: keep this module safe to load independently.
\RequirePackage{amsthm}
\RequirePackage[nameinlink]{cleveref}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Theorem Environments
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\theoremstyle{plain}

\newtheorem{theorem}{Theorem}[section]

\newtheorem{lemma}[theorem]{Lemma}

\newtheorem{corollary}[theorem]{Corollary}

\theoremstyle{definition}

\newtheorem{axiom}[theorem]{Axiom}

\newtheorem{definition}[theorem]{Definition}

\newtheorem{example}[theorem]{Example}

\newtheorem{problem}{Problem}[section]
\newtheorem*{solution}{Solution}

\theoremstyle{remark}
\newtheorem*{remark}{Remark}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Environment Spacing
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\AddToHook{env/theorem/after}{\par\bigskip}
\AddToHook{env/lemma/after}{\par\bigskip}
\AddToHook{env/corollary/after}{\par\bigskip}
\AddToHook{env/axiom/after}{\par\bigskip}
\AddToHook{env/definition/after}{\par\bigskip}
\AddToHook{env/example/after}{\par\bigskip}
\AddToHook{env/problem/after}{\par\bigskip}
\AddToHook{env/solution/after}{\par\bigskip}
\AddToHook{env/remark/after}{\par\bigskip}
\AddToHook{env/proof/after}{\par\bigskip}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Cleveref Names
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\crefname{theorem}{theorem}{theorems}
\Crefname{theorem}{Theorem}{Theorems}

\crefname{lemma}{lemma}{lemmas}
\Crefname{lemma}{Lemma}{Lemmas}

\crefname{corollary}{corollary}{corollaries}
\Crefname{corollary}{Corollary}{Corollaries}

\crefname{axiom}{axiom}{axioms}
\Crefname{axiom}{Axiom}{Axioms}

\crefname{definition}{definition}{definitions}
\Crefname{definition}{Definition}{Definitions}

\crefname{example}{example}{examples}
\Crefname{example}{Example}{Examples}

\crefname{problem}{problem}{problems}
\Crefname{problem}{Problem}{Problems}
