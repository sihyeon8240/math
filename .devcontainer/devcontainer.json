{
  "name": "Undergraduate Mathematics Textbooks",
  "image": "ghcr.io/sihyeon8240/latex@sha256:7441e29c371eebd1ef290289070cf429f9a0d127916d362bc8ade348fddad4eb",

  "containerEnv": {
    "TEXINPUTS": ".:${containerWorkspaceFolder}/common/styles//:${containerWorkspaceFolder}/common/templates//:"
  },

  "postCreateCommand": "./scripts/check-environment.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "james-yu.latex-workshop",
        "github.vscode-github-actions",
        "leanprover.lean4",
        "ms-python.vscode-pylance",
        "ms-python.python",
        "charliermarsh.ruff",
        "editorconfig.editorconfig",
        "redhat.vscode-yaml"
      ],

      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "/bin/bash"
          },
          "zsh": {
            "path": "/bin/zsh"
          }
        },

        "latex-workshop.latex.outDir": "%WORKSPACE_FOLDER%/vscode-build/%RELATIVE_DIR%",

        "latex-workshop.latex.autoBuild.run": "onSave",
        "latex-workshop.view.pdf.viewer": "tab",
        "latex-workshop.latex.recipe.default": "latexmk (LuaLaTeX)",

        "latex-workshop.latex.tools": [
          {
            "name": "latexmk",
            "command": "bash",
            "args": [
              "%WORKSPACE_FOLDER%/scripts/build-vscode.sh",
              "%OUTDIR%",
              "%DOC_EXT%"
            ]
          },
          {
            "name": "latexmk-shell-escape",
            "command": "bash",
            "args": [
              "%WORKSPACE_FOLDER%/scripts/build-vscode.sh",
              "%OUTDIR%",
              "%DOC_EXT%",
              "-shell-escape"
            ]
          }
        ],

        "latex-workshop.latex.recipes": [
          {
            "name": "latexmk (LuaLaTeX)",
            "tools": [
              "latexmk"
            ]
          },
          {
            "name": "latexmk (LuaLaTeX + shell escape)",
            "tools": [
              "latexmk-shell-escape"
            ]
          }
        ]
      }
    }
  }
}
